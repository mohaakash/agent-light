{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentLight",
  "version": "0.1.0",
  "identifier": "com.agentlight.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentLight",
        "width": 1120,
        "height": 900,
        "minWidth": 820,
        "minHeight": 680,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../integrations/codex/hook.mjs",
      "../integrations/claude/hook.mjs",
      "../integrations/agents/hook.mjs"
    ],
    "publisher": "AgentLight",
    "category": "DeveloperTool",
    "shortDescription": "A local status light for AI coding agents",
    "longDescription": "AgentLight displays coding-agent activity in a movable desktop traffic light and optional USB-serial microcontroller hardware. Status stays local, and the virtual indicator works without hardware.",
    "copyright": "Copyright © 2026 AgentLight"
  }
}
